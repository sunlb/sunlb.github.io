#
# Mac
#

alias ll='ls -lFG'
alias la='ls -AG'
alias l='ls -CFG'
alias ls='ls -G'
alias tailf='tail -f'
alias grep='grep --color=auto'

#
# Linux
#

alias ll='ls -l --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias ls='ls --color=auto'
alias tailf='tail -f'   
alias grep='grep --color=auto'